# GPU-enabled Dockerfile template for ML models
FROM {{ BASE_TAG | default('nvcr.io/nvidia/pytorch:24.03-py3') }}

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV CUDA_VISIBLE_DEVICES=0

# Install system dependencies
RUN apt-get update && apt-get install -y \
    git \
    curl \
    wget \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install PyTorch (if different version needed)
{% if PYTORCH_VERSION %}
RUN pip install torch=={{ PYTORCH_VERSION }} torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121
{% endif %}

# Install extra dependencies
{% if EXTRA_DEPENDS %}
RUN pip install {{ EXTRA_DEPENDS }}
{% endif %}

# Create user
ARG USER_ID={{ USER_ID | default('1000') }}
ARG GROUP_ID={{ GROUP_ID | default('1000') }}
RUN groupadd -g ${GROUP_ID} modeluser && \
    useradd -u ${USER_ID} -g ${GROUP_ID} -m -s /bin/bash modeluser

# Create directories
RUN mkdir -p /app /models /var/cache/zoo && \
    chown -R modeluser:modeluser /app /models /var/cache/zoo

# Copy application code
COPY --chown=modeluser:modeluser . /app
WORKDIR /app

# Install Python dependencies
RUN pip install --no-cache-dir -e .

# Switch to non-root user
USER modeluser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Expose port
EXPOSE 8000

# Default command
CMD ["uvicorn", "services.{{ MODEL_NAME }}.app:app", "--host", "0.0.0.0", "--port", "8000"]